DATABASE_URL=mysql+aiomysql://root:@localhost:3306/passport_tracker?charset=utf8mb4

# Automatic mock status checks (minimum interval: 10 seconds)
AUTOMATIC_CHECKS_ENABLED=true
STATUS_CHECK_INTERVAL_SECONDS=10

# Email (Gmail example: use a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_SSL=false
